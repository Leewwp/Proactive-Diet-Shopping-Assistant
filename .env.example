# Optional: Aliyun barcode fallback (used when Open Food Facts has no result).
# The endpoint supports either:
# 1) placeholder: https://example.aliyunapi.com/barcode/{barcode}
# 2) query mode: https://example.aliyunapi.com/barcode  (app appends ?code={barcode} by default)
EXPO_PUBLIC_ALIYUN_BARCODE_ENDPOINT=

# Aliyun Market AppCode for Authorization header: "APPCODE <value>"
EXPO_PUBLIC_ALIYUN_BARCODE_APPCODE=

# Optional query key when endpoint does not use {barcode}
# default is "code"
EXPO_PUBLIC_ALIYUN_BARCODE_PARAM=code

# AI identify (required for Identify mode)
EXPO_PUBLIC_OPENAI_API_KEY=
# Optional overrides
EXPO_PUBLIC_AI_MODEL=gpt-4o
EXPO_PUBLIC_AI_BASE_URL=https://api.openai.com/v1
