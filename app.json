{
  "expo": {
    "name": "Proactive Diet Shopping Assistant",
    "slug": "proactive-diet-shopping-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "proactivedietshoppingassistant",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.polyu.proactivedietshoppingassistant",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to scan product barcodes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#1976D2"
      },
      "package": "com.polyu.proactivedietshoppingassistant",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera for scanning product barcodes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ffa31901-dd7e-4675-9c03-f726639ec47e"
      }
    },
    "owner": "polyu-hci-group"
  }
}
